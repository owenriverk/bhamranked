---
/**
 * Newsletter — Beehiiv signup block, reusable.
 *
 * Reused on the homepage, every listicle, every feature. Slate accent
 * background (DESIGN.md Variant A) with cream text. Beehiiv embed URL
 * is a placeholder; replace before launch.
 *
 * The form posts directly to Beehiiv's hosted endpoint — no JavaScript
 * required, no third-party tracking pixel beyond Beehiiv's own pageview.
 */

interface Props {
  /** Override the default label (used on feature pages to vary tone). */
  label?: string;
  /** Override the default headline. */
  headline?: string;
  /** Override the default body copy. */
  body?: string;
}

const {
  label = 'Newsletter · weekly',
  headline = 'One spot. Visited. In your inbox.',
  body = 'One short editorial per week, one Bellingham spot actually visited. No roundups, no paid placement, no AI-generated lists. Unsubscribe in one click.',
} = Astro.props;
---

<section class="newsletter" id="newsletter" aria-labelledby="newsletter-heading">
  <div class="newsletter-inner">
    <div class="label">{label}</div>
    <h2 id="newsletter-heading">{headline}</h2>
    <p>{body}</p>

    <form
      action="https://embeds.beehiiv.com/PLACEHOLDER-PUBLICATION-ID"
      method="POST"
      target="_blank"
      class="signup-form"
    >
      <label for="newsletter-email" class="visually-hidden">Email address</label>
      <input
        id="newsletter-email"
        type="email"
        name="email"
        placeholder="your@email.com"
        required
        aria-required="true"
        autocomplete="email"
      />
      <button type="submit">Subscribe</button>
    </form>

    <p class="fine">No spam. ~600 words per email. Unsubscribe in one click.</p>
  </div>
</section>

<style>
  .newsletter {
    margin-top: 4rem;
    background: var(--color-accent);
    color: #F0EDE6;
  }
  .newsletter-inner {
    padding: 3rem 2rem;
    max-width: 1180px;
    margin: 0 auto;
  }

  .label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.75;
    margin-bottom: 0.875rem;
  }

  h2 {
    font-family: var(--font-display);
    font-variation-settings: "SOFT" 30, "WONK" 1, "opsz" 144;
    font-weight: 400;
    font-size: 2.25rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
    max-width: 22ch;
    margin: 0 0 1rem;
    color: inherit;
  }

  p {
    font-size: 1rem;
    line-height: 1.55;
    max-width: 55ch;
    opacity: 0.9;
    margin: 0 0 1.5rem;
  }

  .signup-form {
    display: flex;
    gap: 0.5rem;
    max-width: 440px;
    margin-bottom: 0.75rem;
  }

  .signup-form input {
    flex: 1;
    padding: 0.75rem 0.875rem;
    background: transparent;
    border: 1px solid rgba(240, 237, 230, 0.4);
    color: #F0EDE6;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    border-radius: 3px;
  }
  .signup-form input::placeholder { color: rgba(240, 237, 230, 0.55); }
  .signup-form input:focus-visible {
    outline: 2px solid #F0EDE6;
    outline-offset: 2px;
  }

  .signup-form button {
    padding: 0.75rem 1.375rem;
    background: #F0EDE6;
    color: var(--color-accent);
    border: none;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    cursor: pointer;
    border-radius: 3px;
    transition: background 0.08s ease;
  }
  .signup-form button:hover { background: #FFFFFF; }

  .fine {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    opacity: 0.7;
    margin-top: 0.75rem;
    margin-bottom: 0;
    letter-spacing: 0.02em;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 800px) {
    .newsletter-inner { padding: 2rem 1rem; }
    h2 { font-size: 1.75rem; }
    .signup-form { flex-direction: column; }
  }
</style>
