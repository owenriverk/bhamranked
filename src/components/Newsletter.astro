---
/**
 * Newsletter — Beehiiv signup block, reusable.
 *
 * Reused on the homepage, every listicle, every feature. Slate accent
 * background (DESIGN.md Variant A) with cream text. Beehiiv embed URL
 * is a placeholder; replace before launch.
 *
 * The form posts directly to Beehiiv's hosted endpoint — no JavaScript
 * required, no third-party tracking pixel beyond Beehiiv's own pageview.
 */

interface Props {
  /** Override the default label (used on feature pages to vary tone). */
  label?: string;
  /** Override the default headline. */
  headline?: string;
  /** Override the default body copy. */
  body?: string;
}

const {
  label = 'Newsletter · weekly',
  headline = 'One spot. Visited. In your inbox.',
  body = 'One short editorial per week, one Bellingham spot actually visited. No roundups, no paid placement, no AI-generated lists. Unsubscribe in one click.',
} = Astro.props;
---

<section class="newsletter" id="newsletter" aria-labelledby="newsletter-heading">
  <div class="newsletter-inner">
    <div class="label">{label}</div>
    <h2 id="newsletter-heading">{headline}</h2>
    <p>{body}</p>

    <div class="signup-iframe-wrap">
      <iframe
        src="https://embeds.beehiiv.com/32ceef31-5c45-4b5e-bb4c-817b53183c6a?slim=true"
        title="Subscribe to bhamranked"
        loading="lazy"
        frameborder="0"
        scrolling="no"
        class="signup-iframe"
      ></iframe>
    </div>

    <p class="fine">No spam. ~600 words per email. Unsubscribe in one click.</p>
  </div>
</section>

<style>
  .newsletter {
    margin-top: 4rem;
    background: var(--color-accent);
    color: #F0EDE6;
  }
  .newsletter-inner {
    padding: 3rem 2rem;
    max-width: 1180px;
    margin: 0 auto;
  }

  .label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.75;
    margin-bottom: 0.875rem;
  }

  h2 {
    font-family: var(--font-display);
    font-variation-settings: "SOFT" 30, "WONK" 1, "opsz" 144;
    font-weight: 400;
    font-size: 2.25rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
    max-width: 22ch;
    margin: 0 0 1rem;
    color: inherit;
  }

  p {
    font-size: 1rem;
    line-height: 1.55;
    max-width: 55ch;
    opacity: 0.9;
    margin: 0 0 1.5rem;
  }

  .signup-iframe-wrap {
    max-width: 480px;
    margin-bottom: 0.75rem;
    background: transparent;
  }
  .signup-iframe {
    display: block;
    width: 100%;
    min-height: 80px;
    border: 0;
    background: transparent;
  }

  .fine {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    opacity: 0.7;
    margin-top: 0.75rem;
    margin-bottom: 0;
    letter-spacing: 0.02em;
  }

  @media (max-width: 800px) {
    .newsletter-inner { padding: 2rem 1rem; }
    h2 { font-size: 1.75rem; }
    .signup-iframe { min-height: 90px; }
  }
</style>
