---
/**
 * HeroSpot — the #1 ranked spot, full hero layout.
 *
 * 2-column grid (photo left, content right) at desktop; stacked on mobile.
 * Rank "01" floats top-left as a Fraunces numeral. Composes:
 *   VerdictPullquote — the editorial thesis
 *   DataRow          — address / hours / visited / booking
 *   CritiqueCallout  — the honest critique
 *
 * Owen's voice copy lives in the spot frontmatter (takeaway, verdict slot
 * via prop, critique). The body prose is passed via the default slot from
 * the MDX file so Owen can write paragraphs freely.
 */

import type { Spot } from '../lib/types';
import VerdictPullquote from './VerdictPullquote.astro';
import DataRow from './DataRow.astro';
import CritiqueCallout from './CritiqueCallout.astro';

interface Props {
  spot: Spot;
  /** The verdict pullquote — editorial thesis for this spot. */
  verdict: string;
  /** Slug pointing at the companion feature, if any. */
  featureSlug?: string | null;
  /** Category + sub_category, used to build the feature URL. */
  category: string;
  subCategory: string;
}

const { spot, verdict, featureSlug, category, subCategory } = Astro.props;

function fmt(d: Date): string {
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, '0');
  const day = String(d.getDate()).padStart(2, '0');
  return `${y}-${m}-${day}`;
}

const visitFmt = fmt(spot.visit_date);

const dataRows = [
  { label: 'Address', value: spot.address },
  { label: 'Hours', value: spot.hours },
  { label: 'Visited', value: visitFmt },
  { label: 'Booking', value: spot.booking },
];

const featureUrl = featureSlug ? `/${category}/${subCategory}/features/${featureSlug}` : null;
---

<article class="hero-spot" aria-labelledby={`spot-${spot.slug}`}>
  <div class="rank-marker" aria-hidden="true">01</div>

  <div class="hero-photo" role="img" aria-label={`Photo of ${spot.name}`}>
    <span class="placeholder-label">Photo</span>
    <span class="caption">Visit <span class="mono">{visitFmt}</span></span>
  </div>

  <div class="hero-content">
    <h2 id={`spot-${spot.slug}`} class="spot-name">{spot.name}</h2>
    <div class="neighborhood">
      {spot.neighborhood} <span class="dot" aria-hidden="true">·</span> {spot.price_tier}
    </div>

    <VerdictPullquote text={verdict} />

    <div class="hero-body measure">
      <slot />
    </div>

    <DataRow rows={dataRows} />

    <div class="critique-wrap">
      <CritiqueCallout text={spot.honest_critique} />
    </div>

    {featureUrl && (
      <a href={featureUrl} class="feature-link">
        Read the full feature on {spot.name}
      </a>
    )}
  </div>
</article>

<style>
  .hero-spot {
    position: relative;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 3.5rem;
    align-items: start;
    padding: 3.5rem 0;
    border-top: 1px solid var(--color-text-primary);
    border-bottom: 1px solid var(--color-border);
  }

  .rank-marker {
    position: absolute;
    top: -1.75rem;
    left: 0;
    background: var(--color-bg-page);
    color: var(--color-accent);
    font-family: var(--font-display);
    font-variation-settings: "SOFT" 30, "WONK" 1, "opsz" 144;
    font-weight: 500;
    font-size: 3.25rem;
    line-height: 1;
    letter-spacing: -0.04em;
    padding: 0 1rem 0 0;
  }

  .hero-photo {
    position: relative;
    aspect-ratio: 4 / 3;
    background: linear-gradient(135deg, #D6B68A 0%, #A8804A 50%, #6B4E2B 100%);
    overflow: hidden;
  }
  :global([data-theme="dark"]) .hero-photo {
    background: linear-gradient(135deg, #5A4628 0%, #3D2F1A 100%);
  }

  .hero-photo .placeholder-label,
  .hero-photo .caption {
    position: absolute;
    bottom: 0.75rem;
    background: rgba(20, 19, 26, 0.85);
    color: #F0EDE6;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    padding: 0.3125rem 0.5625rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .hero-photo .placeholder-label { left: 0.75rem; border-radius: 2px; }
  .hero-photo .caption {
    right: 0.75rem;
    text-transform: none;
    letter-spacing: 0.02em;
  }
  .hero-photo .caption .mono { font-variant-numeric: tabular-nums; }

  .spot-name {
    font-family: var(--font-display);
    font-variation-settings: "SOFT" 30, "WONK" 0, "opsz" 144;
    font-weight: 500;
    font-size: 3rem;
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 0.5rem;
    color: var(--color-text-primary);
  }

  .neighborhood {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 1.75rem;
  }
  .neighborhood .dot { color: var(--color-border); margin: 0 0.25rem; }

  .hero-body { color: var(--color-text-primary); }
  .hero-body :global(p) {
    margin: 0 0 1rem;
    font-size: 1.0625rem;
    line-height: 1.65;
  }
  .measure { max-width: 50ch; }

  .critique-wrap { margin-top: 1.75rem; }

  .feature-link {
    margin-top: 1.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    border-bottom: 1px solid var(--color-accent);
    padding-bottom: 0.125rem;
  }
  .feature-link::after {
    content: "→";
    font-family: var(--font-body);
  }

  @media (max-width: 800px) {
    .hero-spot {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 2.5rem 0;
    }
    .rank-marker { font-size: 2.5rem; top: -1.25rem; }
    .spot-name { font-size: 2.25rem; }
  }
</style>
