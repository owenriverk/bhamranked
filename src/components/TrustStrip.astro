---
/**
 * TrustStrip — appears immediately under the masthead on every editorial page.
 *
 * Three signals, left-to-right:
 *  1. "No paid placement" pill (mountain green, dot prefix)
 *  2. Visit date range or single last-verified date (mono)
 *  3. Editorial policy link
 *
 * Owen does not write copy here — labels are fixed. Dates come in as props.
 */

interface Props {
  visitRange?: { start: Date; end: Date };
  lastVerified?: Date | null;
}

const { visitRange, lastVerified } = Astro.props;

function fmt(d: Date): string {
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, '0');
  const day = String(d.getDate()).padStart(2, '0');
  return `${y}-${m}-${day}`;
}
---

<div class="trust-strip" role="complementary" aria-label="Editorial trust signals">
  <span class="pill">
    <span class="dot" aria-hidden="true"></span>
    No paid placement
  </span>

  <span class="signal">Visited in person, photos taken on site</span>

  {visitRange && (
    <>
      <span class="sep" aria-hidden="true">·</span>
      <span class="signal">
        Visited <span class="mono">{fmt(visitRange.start)}</span> to <span class="mono">{fmt(visitRange.end)}</span>
      </span>
    </>
  )}

  {!visitRange && lastVerified && (
    <>
      <span class="sep" aria-hidden="true">·</span>
      <span class="signal">Last verified <span class="mono">{fmt(lastVerified)}</span></span>
    </>
  )}

  <span class="sep" aria-hidden="true">·</span>
  <a href="/editorial-policy" class="policy-link">Editorial policy</a>
</div>

<style>
  .trust-strip {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0.875rem 2rem;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.25rem;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.625rem;
    border: 1px solid var(--color-accent-verdict);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent-verdict);
  }
  .pill .dot {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: var(--color-accent-verdict);
  }

  .signal { line-height: 1.4; }

  .mono {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
  }

  .sep { color: var(--color-border); }

  .policy-link {
    color: var(--color-text-muted);
    border-bottom: 1px solid transparent;
  }
  .policy-link:hover {
    color: var(--color-text-primary);
    border-bottom-color: var(--color-text-primary);
  }

  @media (max-width: 800px) {
    .trust-strip {
      padding: 0.875rem 1rem;
      gap: 0.625rem 1rem;
      font-size: 0.75rem;
    }
    .trust-strip .sep { display: none; }
  }
</style>
