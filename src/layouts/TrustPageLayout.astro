---
/**
 * TrustPageLayout — long-form prose container for trust-infrastructure
 * pages (/about, /editorial-policy, /methodology, /contact).
 *
 * Different feel from listicle/feature pages: this is for legible long-form
 * reading. Instrument Sans body, measure capped at ~70ch, generous
 * line-height 1.65, comfortable section spacing. No editorial-display
 * intensity — the words carry it.
 *
 * Composition:
 *   BaseLayout
 *     Masthead
 *     <header.page-header> (kicker + Fraunces headline + dek + optional updated stamp)
 *     <article.prose> (default slot — long-form content)
 *     Footer
 *   JSON-LD blocks (caller-supplied via the `schemaBlocks` prop)
 *
 * The default slot is wrapped in a single `.prose` container that styles
 * common elements (h2, h3, p, ul, ol, blockquote, a) consistently across
 * all four pages. Section markup inside the slot can use the `.section`
 * class for the 64-80px vertical rhythm between major bands.
 */

import BaseLayout from './BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';
import SchemaLD from '../components/SchemaLD.astro';

interface Props {
  title: string;
  description: string;
  kicker?: string;
  dek?: string;
  lastUpdated?: Date | null;
  /** Optional canonical override; defaults to BaseLayout's computed URL. */
  canonical?: string;
  /** JSON-LD blocks to render at the end of the document. */
  schemaBlocks?: Record<string, unknown> | Record<string, unknown>[];
  /** Emit <meta name="robots" content="noindex"> for pages we want crawlable
   *  (so AI search can reach them) but not indexed in Google. */
  noindex?: boolean;
}

const { title, description, kicker, dek, lastUpdated, canonical, schemaBlocks, noindex } = Astro.props;

function fmt(d: Date): string {
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, '0');
  const day = String(d.getDate()).padStart(2, '0');
  return `${y}-${m}-${day}`;
}
---

<BaseLayout title={title} description={description} canonical={canonical} noindex={noindex}>
  <Masthead />

  <main class="container">
    <header class="page-header">
      {kicker && <div class="kicker">{kicker}</div>}
      <h1 class="headline">{title}</h1>
      {dek && <p class="dek">{dek}</p>}
      {lastUpdated && (
        <p class="updated">
          <span class="updated-label">Last updated</span>
          <time datetime={lastUpdated.toISOString()}>{fmt(lastUpdated)}</time>
        </p>
      )}
    </header>

    <article class="prose">
      <slot />
    </article>
  </main>

  <Footer />

  {schemaBlocks && <SchemaLD blocks={schemaBlocks} />}
</BaseLayout>

<style>
  .container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 2rem 6rem;
  }

  .page-header {
    padding: 4rem 0 2.5rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 3.5rem;
  }

  .kicker {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 1.25rem;
  }

  .headline {
    font-family: var(--font-display);
    font-variation-settings: "SOFT" 30, "WONK" 1, "opsz" 144;
    font-weight: 400;
    font-size: clamp(2.25rem, 5.5vw, 3.75rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
    max-width: 22ch;
    margin: 0 0 1.5rem;
    color: var(--color-text-primary);
  }

  .dek {
    font-size: 1.3125rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    max-width: 56ch;
    margin: 0;
  }

  .updated {
    margin: 1.75rem 0 0;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    letter-spacing: 0.04em;
    display: flex;
    gap: 0.625rem;
    align-items: baseline;
  }
  .updated-label {
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  /* =====================================================================
     .prose — the long-form reading container
     ===================================================================== */
  .prose {
    max-width: 70ch;
    margin: 0 auto;
    color: var(--color-text-primary);
  }

  .prose :global(.section) {
    margin: 4rem 0;
  }
  .prose :global(.section:first-child) { margin-top: 0; }
  .prose :global(.section:last-child) { margin-bottom: 0; }

  .prose :global(h2) {
    font-family: var(--font-display);
    font-variation-settings: "SOFT" 30, "WONK" 1, "opsz" 144;
    font-weight: 500;
    font-size: 2rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 3rem 0 1.25rem;
    color: var(--color-text-primary);
  }
  .prose :global(h2:first-child) { margin-top: 0; }

  .prose :global(h3) {
    font-family: var(--font-display);
    font-variation-settings: "SOFT" 30, "WONK" 1, "opsz" 144;
    font-weight: 500;
    font-size: 1.5rem;
    line-height: 1.15;
    letter-spacing: -0.015em;
    margin: 2.25rem 0 1rem;
    color: var(--color-text-primary);
  }

  .prose :global(p) {
    font-size: 1.125rem;
    line-height: 1.65;
    margin: 0 0 1.25rem;
    color: var(--color-text-primary);
  }

  .prose :global(p.lede) {
    font-size: 1.25rem;
    color: var(--color-text-muted);
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.5rem;
    padding-left: 1.5rem;
    font-size: 1.0625rem;
    line-height: 1.6;
  }
  .prose :global(li) {
    margin-bottom: 0.5rem;
  }
  .prose :global(li::marker) {
    color: var(--color-accent);
  }

  .prose :global(a) {
    color: var(--color-accent);
    border-bottom: 1px solid var(--color-accent);
    padding-bottom: 0.0625rem;
  }
  .prose :global(a:hover) {
    color: var(--color-accent-deep);
    border-bottom-color: var(--color-accent-deep);
  }

  /* Pull statement: the canonical no-paid-placement promise and similar
     editorial-thesis sentences. Italic Fraunces with verdict-green accent
     bar, per the DESIGN.md "verdict pullquote" pattern. */
  .prose :global(blockquote),
  .prose :global(.pull-statement) {
    margin: 2.5rem 0;
    padding: 0.5rem 0 0.5rem 1.5rem;
    border-left: 3px solid var(--color-accent-verdict);
    font-family: var(--font-display);
    font-variation-settings: "SOFT" 50, "WONK" 1, "opsz" 18;
    font-style: italic;
    font-size: 1.375rem;
    line-height: 1.35;
    color: var(--color-accent-verdict);
  }
  .prose :global(blockquote p),
  .prose :global(.pull-statement p) {
    font-family: inherit;
    font-style: inherit;
    font-size: inherit;
    line-height: inherit;
    color: inherit;
    margin: 0 0 0.75rem;
  }
  .prose :global(blockquote p:last-child),
  .prose :global(.pull-statement p:last-child) {
    margin-bottom: 0;
  }

  /* Owen-input markers — visible but restrained. Reminds Owen on every
     visit that voice content lives here. Won't ship to production because
     Owen will replace these before launch. */
  .prose :global(.owen-input) {
    display: block;
    margin: 1rem 0 1.5rem;
    padding: 1rem 1.125rem;
    background: var(--color-bg-elevated);
    border-left: 3px solid var(--color-accent-critique);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--color-accent-critique);
    letter-spacing: 0.01em;
  }
  .prose :global(.owen-input-label) {
    display: block;
    font-size: 0.625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-bottom: 0.375rem;
    opacity: 0.85;
  }

  /* Data row pattern for sameAs links, email rows, etc. */
  .prose :global(.data-list) {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.625rem 1.75rem;
    margin: 1.5rem 0 2rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  .prose :global(.data-list dt) {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    align-self: center;
  }
  .prose :global(.data-list dd) {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: 0.8125rem;
    color: var(--color-text-primary);
    margin: 0;
    word-break: break-word;
  }
  .prose :global(.data-list dd a) {
    border-bottom: 1px solid transparent;
    padding-bottom: 0;
  }
  .prose :global(.data-list dd a:hover) {
    border-bottom-color: var(--color-accent);
  }

  /* CTA card — used on /about pointing to /contact, etc. */
  .prose :global(.cta-card) {
    margin: 3rem 0 0;
    padding: 2rem 2rem 2.25rem;
    background: var(--color-bg-elevated);
    border-radius: 2px;
  }
  .prose :global(.cta-card h3) {
    margin-top: 0;
  }
  .prose :global(.cta-card p:last-child) {
    margin-bottom: 0;
  }
  .prose :global(.cta-card a.cta-link) {
    display: inline-block;
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-variation-settings: "SOFT" 30, "WONK" 1, "opsz" 144;
    font-weight: 500;
    font-size: 1.125rem;
    color: var(--color-accent);
    border-bottom: 2px solid var(--color-accent);
    padding-bottom: 0.125rem;
  }

  /* Portrait placeholder (for /about hero photo). Sized for a portrait
     crop, restrained desaturated tones per DESIGN.md photo treatment. */
  .prose :global(.portrait-placeholder) {
    position: relative;
    aspect-ratio: 4 / 5;
    max-width: 360px;
    margin: 0 0 2.5rem;
    background: linear-gradient(135deg, #D6B68A 0%, #A8804A 50%, #6B4E2B 100%);
    border-radius: 2px;
  }
  :global([data-theme="dark"]) .prose :global(.portrait-placeholder) {
    background: linear-gradient(135deg, #5A4628 0%, #3D2F1A 100%);
  }
  .prose :global(.portrait-placeholder .placeholder-label) {
    position: absolute;
    bottom: 0.75rem;
    left: 0.75rem;
    background: rgba(20, 19, 26, 0.85);
    color: #F0EDE6;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    padding: 0.3125rem 0.5625rem;
    border-radius: 2px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* Contact section blocks — three lanes (editorial / consider / advertising). */
  .prose :global(.contact-lane) {
    margin: 2.5rem 0;
    padding: 1.75rem 0 2rem;
    border-top: 1px solid var(--color-border);
  }
  .prose :global(.contact-lane:last-child) {
    border-bottom: 1px solid var(--color-border);
  }
  .prose :global(.contact-lane h3) {
    margin-top: 0;
  }
  .prose :global(.contact-lane .lane-label) {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 0.625rem;
    display: block;
  }
  .prose :global(.contact-lane .lane-email) {
    display: inline-block;
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    color: var(--color-accent);
    border-bottom: 1px solid var(--color-accent);
    padding-bottom: 0.0625rem;
  }
  .prose :global(.contact-lane .lane-no-email) {
    display: inline-block;
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
  }

  @media (max-width: 800px) {
    .container { padding: 0 1rem 3rem; }
    .page-header { padding: 2.5rem 0 2rem; margin-bottom: 2.5rem; }
    .prose :global(h2) { font-size: 1.75rem; }
    .prose :global(.cta-card) { padding: 1.5rem 1.25rem; }
    .prose :global(.data-list) { gap: 0.5rem 1rem; }
  }
</style>
