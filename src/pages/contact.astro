---
/**
 * /contact — three clearly labeled inquiry paths.
 *
 *   1. Editorial — corrections, factual errors, questions about a piece
 *   2. Consider for review — businesses asking to be visited
 *   3. Advertising — explicit clean-lanes statement (not currently offered)
 *
 * The page is safe to draft because the lane definitions are project-level
 * positioning. Owen confirms or changes the placeholder email addresses
 * before launch.
 */

import TrustPageLayout from '../layouts/TrustPageLayout.astro';
import { buildBreadcrumbSchema } from '../lib/schema';

const SITE_URL = 'https://bhamranked.com';

const title = 'Contact bhamranked';
const description =
  'Three contact paths for bhamranked: editorial corrections, businesses asking to be considered for review, and advertising inquiries.';

const contactPage: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: title,
  description,
  url: `${SITE_URL}/contact`,
  mainEntity: {
    '@type': 'Organization',
    '@id': `${SITE_URL}#organization`,
    name: 'bhamranked',
    url: SITE_URL,
    contactPoint: [
      {
        '@type': 'ContactPoint',
        contactType: 'editorial',
        email: 'corrections@bhamranked.com',
        areaServed: 'US-WA',
        availableLanguage: ['English'],
      },
      {
        '@type': 'ContactPoint',
        contactType: 'business inquiries',
        email: 'consider@bhamranked.com',
        areaServed: 'US-WA',
        availableLanguage: ['English'],
      },
    ],
  },
};

const schemaBlocks = [
  contactPage,
  buildBreadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Contact', url: '/contact' },
  ]),
];
---

<TrustPageLayout
  title={title}
  description={description}
  kicker="Contact"
  dek="Three separate paths so the right message reaches the right inbox. Editorial inquiries stay separate from business inquiries, and the advertising lane has its own honest answer."
  schemaBlocks={schemaBlocks}
>
  <section class="section">
    <div class="contact-lane">
      <span class="lane-label">01 · Editorial inquiries</span>
      <h3>Corrections and questions about a piece</h3>
      <p>
        If you spotted an error of fact in a published piece (a wrong address,
        wrong hours, an ownership change we missed) or you have a question
        about how a ranking was made, write to the editorial inbox. We aim to
        respond within 48 hours and post dated corrections on the affected
        piece when the fix is non-trivial.
      </p>
      <a class="lane-email" href="mailto:corrections@bhamranked.com">
        corrections@bhamranked.com
      </a>
      <p class="owen-input">
        <span class="owen-input-label">[OWEN INPUT NEEDED]</span>
        Confirm or change this email address. If the inbox should be something
        like editor@bhamranked.com, hello@bhamranked.com, or owen@bhamranked.com,
        update it in both places (the visible mailto and the ContactPoint
        JSON-LD).
      </p>
    </div>

    <div class="contact-lane">
      <span class="lane-label">02 · Businesses asking to be considered for review</span>
      <h3>You'd like us to visit</h3>
      <p>
        Visits happen on our timeline, not the business's. We never accept
        comped meals or payment for placement. If you'd like to be considered,
        send your address, hours, and one sentence on what you think makes
        you stand apart. We'll add you to the list of places to visit. There
        is no fee, no guaranteed coverage, and no editorial trade. If we
        visit and the piece doesn't favor you, that piece still publishes.
      </p>
      <a class="lane-email" href="mailto:consider@bhamranked.com">
        consider@bhamranked.com
      </a>
      <p class="owen-input">
        <span class="owen-input-label">[OWEN INPUT NEEDED]</span>
        Confirm or change this email address. Same note as above on the
        ContactPoint JSON-LD if you rename it.
      </p>
    </div>

    <div class="contact-lane">
      <span class="lane-label">03 · Advertising and featured placement</span>
      <h3>The clean-lanes answer</h3>
      <p>
        bhamranked does not currently sell featured placement or advertising.
        If that ever changes, this page will say so clearly and the commerce
        side will live on a separate URL from editorial. Until then, please
        do not send pitches; they will not be read and they will not get a
        response.
      </p>
      <span class="lane-no-email">No inbox by design.</span>
    </div>
  </section>

  <section class="section">
    <h2>Where else to find bhamranked</h2>
    <p>
      Owen's personal social profiles are listed on the
      <a href="/about">about page</a>. The site itself doesn't run separate
      accounts. The newsletter is the canonical way to follow new pieces.
    </p>
    <dl class="data-list">
      <dt>RSS</dt>
      <dd><a href="/feed.xml">/feed.xml</a></dd>
      <dt>Newsletter</dt>
      <dd><a href="/#newsletter">Subscribe on the homepage</a></dd>
      <dt>Policy</dt>
      <dd><a href="/editorial-policy">/editorial-policy</a></dd>
      <dt>Methodology</dt>
      <dd><a href="/methodology">/methodology</a></dd>
    </dl>
  </section>
</TrustPageLayout>
