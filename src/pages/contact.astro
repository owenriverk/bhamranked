---
/**
 * /contact — one inbox, three honest positions.
 *
 * Editorial corrections, business inquiries, and the advertising
 * clean-lanes statement all live here, but everything routes to a
 * single address (owen@bhamranked.com) so messages can't get lost in
 * a maze of dedicated inboxes.
 */

import TrustPageLayout from '../layouts/TrustPageLayout.astro';
import { buildBreadcrumbSchema } from '../lib/schema';

const SITE_URL = 'https://bhamranked.com';
const CONTACT_EMAIL = 'owen@bhamranked.com';

const title = 'Contact bhamranked';
const description =
  'One inbox for bhamranked: editorial corrections, business inquiries, and the advertising clean-lanes answer.';

const contactPage: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: title,
  description,
  url: `${SITE_URL}/contact`,
  mainEntity: {
    '@type': 'Organization',
    '@id': `${SITE_URL}#organization`,
    name: 'bhamranked',
    url: SITE_URL,
    contactPoint: [
      {
        '@type': 'ContactPoint',
        contactType: 'editorial',
        email: CONTACT_EMAIL,
        areaServed: 'US-WA',
        availableLanguage: ['English'],
      },
    ],
  },
};

const schemaBlocks = [
  contactPage,
  buildBreadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Contact', url: '/contact' },
  ]),
];
---

<TrustPageLayout
  title={title}
  description={description}
  kicker="Contact"
  dek="One inbox. Read it most days."
  schemaBlocks={schemaBlocks}
>
  <section class="section">
    <p class="lead">
      Everything goes to the same place:
    </p>
    <p class="email-row">
      <a class="lane-email" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
    </p>
  </section>

  <section class="section">
    <h2>What to write about</h2>
    <ul>
      <li>
        <strong>Corrections.</strong> Wrong address, wrong hours, an ownership
        change a piece missed. Replies within 48 hours; non-trivial
        corrections get a dated note on the affected piece.
      </li>
      <li>
        <strong>Businesses asking to be considered.</strong> Send your
        address, hours, and one sentence on what you think makes you stand
        apart. No fee, no guaranteed coverage, no editorial trade. Visits
        happen on bhamranked's timeline.
      </li>
      <li>
        <strong>Anything else.</strong> A thoughtful pitch, a tip, a question
        about how a piece got made.
      </li>
    </ul>
  </section>

  <section class="section">
    <h2>One honest answer up front</h2>
    <p>
      bhamranked does not sell featured placement or advertising. Pitches
      about that don't get a response. If that ever changes, this page will
      say so and the commerce side will live on a separate URL from the
      editorial side.
    </p>
  </section>

  <section class="section">
    <h2>Where else to find bhamranked</h2>
    <p>
      Owen's personal social profiles are listed on the
      <a href="/about">about page</a>. The site itself doesn't run separate
      accounts. The newsletter is the canonical way to follow new pieces.
    </p>
    <dl class="data-list">
      <dt>RSS</dt>
      <dd><a href="/feed.xml">/feed.xml</a></dd>
      <dt>Newsletter</dt>
      <dd><a href="/#newsletter">Subscribe on the homepage</a></dd>
      <dt>Policy</dt>
      <dd><a href="/editorial-policy">/editorial-policy</a></dd>
    </dl>
  </section>
</TrustPageLayout>

<style>
  .lead {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }
  .email-row {
    margin-bottom: 1.5rem;
  }
  .lane-email {
    font-family: var(--font-display);
    font-variation-settings: "SOFT" 30, "WONK" 1, "opsz" 144;
    font-weight: 500;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    color: var(--color-accent);
    letter-spacing: -0.02em;
    border-bottom: 2px solid var(--color-accent);
    padding-bottom: 0.25rem;
  }
</style>
