---
/**
 * Category landing page — generates one route per top-level vertical.
 *
 *   /food-and-drink
 *   /home-services
 *   /personal-services
 *   /specialty-retail
 *
 * For categories with no published content (everything except
 * food-and-drink at MVP), renders a "Coming later in 2026" placeholder.
 */

import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Masthead from '../../components/Masthead.astro';
import Footer from '../../components/Footer.astro';
import Newsletter from '../../components/Newsletter.astro';
import SchemaLD from '../../components/SchemaLD.astro';
import {
  CATEGORIES,
  CATEGORY_LABELS,
  SUBS_BY_CATEGORY,
  SUB_CATEGORY_LABELS,
  ACTIVE_CATEGORIES,
} from '../../content/config';
import type { Category } from '../../content/config';
import { buildBreadcrumbSchema } from '../../lib/schema';

export async function getStaticPaths() {
  return CATEGORIES.map((category) => ({ params: { category } }));
}

const { category } = Astro.params;
const cat = category as Category;
const categoryLabel = CATEGORY_LABELS[cat];
const subs = SUBS_BY_CATEGORY[cat];
const isActive = ACTIVE_CATEGORIES.includes(cat);

// For active categories, pull published listicles so we can show counts.
const allListicles = await getCollection('listicle', (entry) => {
  const published = entry.data.published;
  return entry.data.category === cat && published !== null && published <= new Date();
});

// Group by sub_category.
const bySub = new Map<string, typeof allListicles>();
for (const sub of subs) {
  bySub.set(sub, []);
}
for (const entry of allListicles) {
  const arr = bySub.get(entry.data.sub_category) ?? [];
  arr.push(entry);
  bySub.set(entry.data.sub_category, arr);
}

const title = isActive
  ? `${categoryLabel} in Bellingham, ranked. bhamranked.`
  : `${categoryLabel} in Bellingham — coming in 2026. bhamranked.`;

const description = isActive
  ? `Ranked editorial guides to ${categoryLabel.toLowerCase()} in Bellingham, WA. First-person reviews, every spot visited in person. No paid placement, no comped meals.`
  : `${categoryLabel} reviews are coming to bhamranked later in 2026. First-person rankings, every business visited in person, no paid placement.`;

const breadcrumbs = buildBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: categoryLabel, url: `/${cat}` },
]);
---

<BaseLayout title={title} description={description} canonical={`/${cat}`}>
  <Masthead />

  <main class="container">
    <section class="header">
      <div class="kicker">{categoryLabel}</div>
      <h1 class="display">
        {isActive
          ? `${categoryLabel} in Bellingham, ranked.`
          : `${categoryLabel} are coming.`}
      </h1>
      <p class="lede">
        {isActive
          ? `Ranked guides to the businesses worth your weekend, visited in person and photographed on site. Pick a sub-category below.`
          : `bhamranked is starting with food. ${categoryLabel.toLowerCase()} reviews join the directory later in 2026, ranked under the same rules: visited in person, no paid placement, no comped service.`}
      </p>
    </section>

    {isActive ? (
      <section class="sub-grid" aria-label={`${categoryLabel} sub-categories`}>
        {subs.map((sub) => {
          const count = bySub.get(sub)?.length ?? 0;
          const subLabel = SUB_CATEGORY_LABELS[sub] ?? sub;
          return (
            <a href={`/${cat}/${sub}`} class="sub-card">
              <h2 class="sub-name">{subLabel}</h2>
              <div class="sub-meta">
                {count === 0
                  ? 'Guide in progress'
                  : count === 1
                    ? '1 ranked guide'
                    : `${count} ranked guides`}
              </div>
            </a>
          );
        })}
      </section>
    ) : (
      <section class="placeholder">
        <div class="kicker">Coming later in 2026</div>
        <h2>Sub-categories planned</h2>
        <ul class="planned-list">
          {subs.map((sub) => (
            <li>{SUB_CATEGORY_LABELS[sub] ?? sub}</li>
          ))}
        </ul>
        <p class="placeholder-note">
          Reviews launch when each sub-category has at least five spots visited and ranked.
          Subscribe below to hear when the first one ships.
        </p>
      </section>
    )}
  </main>

  <Newsletter />
  <Footer />

  <SchemaLD blocks={breadcrumbs} />
</BaseLayout>

<style>
  .container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 2rem 4rem;
  }

  .header { padding: 4rem 0 3rem; }

  .kicker {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 1.5rem;
  }

  .display {
    font-family: var(--font-display);
    font-variation-settings: "SOFT" 30, "WONK" 1, "opsz" 144;
    font-weight: 400;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
    max-width: 20ch;
    margin: 0 0 1.5rem;
    color: var(--color-text-primary);
  }

  .lede {
    font-size: 1.3125rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    max-width: 60ch;
    margin: 0;
  }

  .sub-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
    margin-top: 2rem;
  }

  .sub-card {
    display: block;
    padding: 1.75rem;
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: 2px;
    color: inherit;
    transition: background 0.1s ease, border-color 0.1s ease;
  }
  .sub-card:hover {
    background: var(--color-bg-elevated);
    border-color: var(--color-text-primary);
  }

  .sub-name {
    font-family: var(--font-display);
    font-variation-settings: "SOFT" 30, "WONK" 0, "opsz" 144;
    font-weight: 500;
    font-size: 1.75rem;
    line-height: 1.1;
    letter-spacing: -0.015em;
    margin: 0 0 0.5rem;
  }

  .sub-meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .placeholder {
    background: var(--color-bg-elevated);
    padding: 3rem;
    border-radius: 2px;
    max-width: 760px;
  }
  .placeholder h2 {
    font-family: var(--font-display);
    font-variation-settings: "SOFT" 30, "WONK" 1, "opsz" 144;
    font-weight: 500;
    font-size: 2rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 1.5rem;
  }
  .planned-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
  }
  .planned-list li {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    padding: 0.375rem 0.75rem;
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: 3px;
    color: var(--color-text-primary);
  }
  .placeholder-note {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-text-muted);
    max-width: 60ch;
    margin: 0;
  }

  @media (max-width: 800px) {
    .container { padding: 0 1rem 3rem; }
    .header { padding: 2.5rem 0 2rem; }
    .placeholder { padding: 1.75rem; }
  }
</style>
