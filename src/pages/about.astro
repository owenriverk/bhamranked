---
/**
 * /about — Owen's author bio page.
 *
 * Drafted from seed facts (decade in Bellingham, the portrait, Owen's
 * own phrasings from chat) and run through /humanizer. Owen edits to
 * taste. The Person JSON-LD references the sameAs URLs in
 * src/lib/schema.ts — keep that array in sync with the visible
 * "Receipts" data list below.
 */

import { Image } from 'astro:assets';
import TrustPageLayout from '../layouts/TrustPageLayout.astro';
import {
  buildPersonSchema,
  buildBreadcrumbSchema,
} from '../lib/schema';
import portraitImage from '../assets/about/portrait.jpg';

const title = 'About Owen — bhamranked';
const description =
  "I've lived in Bellingham for ten years. Every piece on bhamranked is what I actually thought after visiting the place in person.";

const schemaBlocks = [
  buildPersonSchema(),
  buildBreadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'About', url: '/about' },
  ]),
];
---

<TrustPageLayout
  title={title}
  headline="About Owen"
  description={description}
  kicker="Who ranked these"
  dek="Hamster... Original thoughts about my favorite local places."
  schemaBlocks={schemaBlocks}
>
  <section class="section portrait-section">
    <Image
      src={portraitImage}
      alt="Owen, holding a brown trout at sunset on a river, somewhere drier than Bellingham."
      widths={[600, 1000, 1600]}
      sizes="(max-width: 800px) 100vw, 720px"
      format="avif"
      loading="eager"
      class="portrait"
    />
  </section>

  <section class="section">
    <h2>Hi, I'm Owen</h2>
    <p>
      I'm Owen. I've been a Bellinghamster for ten years. bhamranked is
      where I write down what's worth your time in this town and what
      isn't.
    </p>
  </section>

  <section class="section">
    <h2>Why?</h2>
    <p>
      Family visits. Friends pass through on their way between
      Seattle and Vancouver. Every time, the same question: where
      do we eat?
    </p>
    <p>
      After ten years the shortlist is long. The brunch I take my
      family to isn't where I send friends who are passing through.
      The dinner I save for special occasions is its own list. So is
      the breakfast I default to when I've got nothing to prove. The
      list keeps growing.
    </p>
    <p>
      bhamranked is the list. Finally written down so I don't have to
      text it to someone every couple of months.
    </p>
  </section>

  <section class="section">
    <h2>The pitch</h2>
    <p>
      bhamranked is a Bellingham directory I write myself. Every place on
      it is somewhere I've gone in person, with photos I took. No business
      pays to be on the list. No meal has been comped. If that ever
      changes, you'll see it on this site before you see anything else.
    </p>
    <p>
      The reason this exists: there are a hundred "best of Bellingham"
      lists out there. Most are written by people who've never been to
      Bellingham. They rank well on Google. They're rarely right.
    </p>
  </section>

  <section class="section">
    <h2>When I'm not eating</h2>
    <p>
      When I'm not eating somewhere in town, I'm usually somewhere
      outside it. Ten years in and I still want to be here.
    </p>
  </section>

  <section class="section">
    <h2>Receipts</h2>
    <dl class="data-list">
      <dt>LinkedIn</dt>
      <dd>
        <a href="https://www.linkedin.com/in/owen-kurth-7647b9266/" rel="me noopener">
          linkedin.com/in/owen-kurth
        </a>
      </dd>
      <dt>Instagram</dt>
      <dd>
        <a href="https://www.instagram.com/owenkurth" rel="me noopener">
          instagram.com/owenkurth
        </a>
      </dd>
      <dt>Personal site</dt>
      <dd>
        <a href="https://owenkurth.com" rel="me noopener">owenkurth.com</a>
      </dd>
    </dl>
  </section>

  <section class="section">
    <div class="cta-card">
      <h3>Want to get in touch?</h3>
      <p>
        One inbox for everything: corrections, businesses asking to be
        considered, anything else.
      </p>
      <a href="/contact" class="cta-link">Contact bhamranked &rarr;</a>
    </div>
  </section>
</TrustPageLayout>

<style>
  .portrait-section {
    margin-bottom: 3rem;
  }
  .portrait {
    width: 100%;
    display: block;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: center 38%;
    border-radius: 2px;
  }
</style>
