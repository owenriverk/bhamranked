---
/**
 * /about — Owen's author bio page.
 *
 * Drafted by Claude from the seed fact "I've been a bellinghamster for a
 * decade" + the portrait + project context. Owen edits to taste.
 *
 * The Person JSON-LD is emitted with the canonical fields populated;
 * sameAs URLs are still placeholders that Owen will fill in. Once filled,
 * this page becomes the EEAT anchor for every piece (every Article and
 * Review schema references @id on this page).
 */

import { Image } from 'astro:assets';
import TrustPageLayout from '../layouts/TrustPageLayout.astro';
import {
  buildPersonSchema,
  buildBreadcrumbSchema,
} from '../lib/schema';
import portraitImage from '../assets/about/portrait.jpg';

const title = 'About Owen — bhamranked';
const description =
  "I've lived in Bellingham for ten years. Every piece on bhamranked is what I actually thought after visiting the place in person.";

const schemaBlocks = [
  buildPersonSchema(),
  buildBreadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'About', url: '/about' },
  ]),
];
---

<TrustPageLayout
  title={title}
  description={description}
  kicker="Who ranked these"
  dek="I've been here ten years. Every piece on this site is what I actually thought after going to the place."
  schemaBlocks={schemaBlocks}
>
  <section class="section portrait-section">
    <Image
      src={portraitImage}
      alt="Owen, mid-turn through powder on Mt. Baker, with the home mountain rising in the background."
      widths={[600, 1000, 1600]}
      sizes="(max-width: 800px) 100vw, 1100px"
      format="avif"
      loading="eager"
      class="portrait"
    />
  </section>

  <section class="section">
    <h2>The basic narrative</h2>
    <p>
      I'm Owen. Ten years a Bellinghamster. That's Mt. Baker behind me, the
      one you see from town when the weather lifts. I've kept a list of
      places I'd send my sister to in this town for most of those ten years,
      and bhamranked is where I finally write it down.
    </p>
    <p>
      I'm not a chef. Never went to culinary school, never worked in a
      kitchen. What I have is a decade of eating in this town and paying
      attention.
    </p>
  </section>

  <section class="section">
    <h2>Why food and drink</h2>
    <p>
      Honest answer: I started bhamranked because Yelp is gamed and Google
      reviews are worse. The first result for any "best brunch in Bellingham"
      search is usually a place I wouldn't send anyone. Meanwhile the spot
      you actually want, the one a local would point you to, gets buried
      under AI-generated lists by people who've never been to the city.
    </p>
    <p>
      This isn't Yelp because there's actually a person behind it. I go to
      the places, eat what's on the menu, and write what I think. The photos
      are mine. Ten years here is enough context.
    </p>
  </section>

  <section class="section">
    <h2>What I'm trying to do here</h2>
    <p>
      Short version: bhamranked is a Bellingham directory you can actually
      trust because one person visits every place on it and writes what he
      thinks.
    </p>
    <p>
      Longer version: every piece on this site is one real visit, one real
      opinion, photographed on site and dated. No business pays for placement.
      No meal has been comped. The day either of those changes, this site
      will say so first, and the commerce side will live on a different URL
      than the editorial.
    </p>
  </section>

  <section class="section">
    <h2>One more thing</h2>
    <p>
      Outside of bhamranked, I'm outdoors when I can be. Bellingham earns its
      reputation for that. Ten years in, I still want to be here.
    </p>
  </section>

  <section class="section">
    <h2>Where to find me elsewhere</h2>
    <p>
      These profiles feed the Person schema on this page so Google and AI
      models can verify the byline. Replace each placeholder URL with the
      real one before launch.
    </p>
    <dl class="data-list">
      <dt>LinkedIn</dt>
      <dd>[OWEN INPUT NEEDED: actual LinkedIn URL]</dd>
      <dt>Twitter / X</dt>
      <dd>[OWEN INPUT NEEDED: actual Twitter URL]</dd>
      <dt>Instagram</dt>
      <dd>[OWEN INPUT NEEDED: actual Instagram URL]</dd>
      <dt>Personal site</dt>
      <dd>[OWEN INPUT NEEDED: actual personal site URL]</dd>
    </dl>
  </section>

  <section class="section">
    <div class="cta-card">
      <h3>Want to get in touch?</h3>
      <p>
        One inbox for everything: corrections, businesses asking to be
        considered, anything else.
      </p>
      <a href="/contact" class="cta-link">Contact bhamranked &rarr;</a>
    </div>
  </section>
</TrustPageLayout>

<style>
  .portrait-section {
    margin-bottom: 3rem;
  }
  .portrait {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 2px;
  }
</style>
