---
/**
 * /about — Owen's author bio page.
 *
 * Drafted from seed facts (decade in Bellingham, the portrait, Owen's
 * own phrasings from chat) and run through /humanizer. Owen edits to
 * taste. The Person JSON-LD references the sameAs URLs in
 * src/lib/schema.ts — keep that array in sync with the visible
 * "Receipts" data list below.
 */

import { Image } from 'astro:assets';
import TrustPageLayout from '../layouts/TrustPageLayout.astro';
import {
  buildPersonSchema,
  buildBreadcrumbSchema,
} from '../lib/schema';
import portraitImage from '../assets/about/portrait.jpg';

const title = 'About Owen — bhamranked';
const description =
  "I've lived in Bellingham for ten years. Every piece on bhamranked is what I actually thought after visiting the place in person.";

const schemaBlocks = [
  buildPersonSchema(),
  buildBreadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'About', url: '/about' },
  ]),
];
---

<TrustPageLayout
  title={title}
  description={description}
  kicker="Who ranked these"
  dek="Ten years a Bellinghamster. Every piece on this site is what I actually thought after going to the place — not what an algorithm thinks I should have."
  schemaBlocks={schemaBlocks}
>
  <section class="section portrait-section">
    <Image
      src={portraitImage}
      alt="Owen, holding a brown trout at sunset on a river — somewhere drier than Bellingham."
      widths={[600, 1000, 1600]}
      sizes="(max-width: 800px) 100vw, 720px"
      format="avif"
      loading="eager"
      class="portrait"
    />
  </section>

  <section class="section">
    <h2>Hi, I'm Owen</h2>
    <p>
      Ten years a Bellinghamster, with zero culinary credentials and a list
      of places I'd send my sister to that started editing itself in my head
      around year three. bhamranked is where the list finally gets written
      down.
    </p>
    <p>
      I'm not a chef. Never went to culinary school, never worked in a
      kitchen. What I have is a decade of paying attention in this town,
      which it turns out counts for more than the internet gives it credit
      for.
    </p>
  </section>

  <section class="section">
    <h2>The pitch</h2>
    <p>
      Short version: bhamranked is a Bellingham directory you can actually
      trust because one person visits every place on it and writes what he
      thinks. That person is me.
    </p>
    <p>
      Longer version: I started this because Yelp is gamed, Google reviews
      are worse, and the first result for "best brunch in Bellingham" is
      usually a place I wouldn't send anyone. Meanwhile the spot you actually
      want gets buried under AI-generated lists by people who've never set
      foot in the city.
    </p>
    <p>
      Every piece is one real visit, one real opinion, photographed on site
      and dated. The photos are mine. No business pays for placement. No
      meal has been comped. The day either of those changes, this site will
      say so first, and the commerce side will live on a different URL than
      the editorial.
    </p>
  </section>

  <section class="section">
    <h2>When I'm not eating</h2>
    <p>
      Most weekends in this town involve me eating somewhere I'm taking
      notes about. The other ones I'm outside doing something else,
      occasionally with a fish involved. Ten years in, I still want to be
      here.
    </p>
  </section>

  <section class="section">
    <h2>Receipts</h2>
    <p>
      These profiles feed the Person schema on this page, which is how
      Google and AI search confirm a real human is behind the byline and
      not a content farm with a thesaurus. Receipts:
    </p>
    <dl class="data-list">
      <dt>LinkedIn</dt>
      <dd>
        <a href="https://www.linkedin.com/in/owen-kurth-7647b9266/" rel="me noopener">
          linkedin.com/in/owen-kurth
        </a>
      </dd>
      <dt>Instagram</dt>
      <dd>
        <a href="https://www.instagram.com/owenkurth" rel="me noopener">
          instagram.com/owenkurth
        </a>
      </dd>
      <dt>Personal site</dt>
      <dd>
        <a href="https://owenkurth.com" rel="me noopener">owenkurth.com</a>
      </dd>
    </dl>
  </section>

  <section class="section">
    <div class="cta-card">
      <h3>Want to get in touch?</h3>
      <p>
        One inbox for everything: corrections, businesses asking to be
        considered, anything else.
      </p>
      <a href="/contact" class="cta-link">Contact bhamranked &rarr;</a>
    </div>
  </section>
</TrustPageLayout>

<style>
  .portrait-section {
    margin-bottom: 3rem;
  }
  .portrait {
    width: 100%;
    display: block;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: center 38%;
    border-radius: 2px;
  }
</style>
