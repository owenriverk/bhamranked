---
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';
import SchemaLD from '../components/SchemaLD.astro';
import {
  buildOrganizationSchema,
  buildWebsiteSchema,
  buildPersonSchema,
} from '../lib/schema';

const title = 'bhamranked — first-person Bellingham restaurant reviews';
const description = 'Ranked guides to the best restaurants, coffee, breweries, and businesses in Bellingham, WA. Visited in person. No paid placement, no comped meals, no sponsored content.';

// Homepage emits Organization + WebSite + Person blocks. These are the
// canonical author/publisher references that listicle/feature pages link
// to via @id — emitting them once on / lets Google de-dupe across the site.
const schemaBlocks = [
  buildOrganizationSchema(),
  buildWebsiteSchema(),
  buildPersonSchema(),
];
---

<BaseLayout title={title} description={description}>
  <Masthead />

  <main class="container">
    <section class="hero">
      <div class="kicker">A Bellingham, WA directory</div>
      <h1 class="display">
        First-person reviews of the businesses I'd send my friends to.
      </h1>
      <p class="lede">
        No paid placement. No comped meals. No AI-generated lists. Every spot on bhamranked was visited in person and photographed on site. Ranked, with opinions.
      </p>
      <div class="cta-row">
        <a href="/food-and-drink/brunch" class="cta-primary">Read the brunch guide →</a>
      </div>
    </section>

    <section class="status">
      <div class="status-card">
        <div class="status-label">Status</div>
        <h2 class="status-headline">Site is live. First piece is coming.</h2>
        <p>The Bellingham brunch guide ships next. Subscribe below if you want the first piece in your inbox before it lands on Google.</p>
        <div class="newsletter-iframe-wrap">
          <iframe
            src="https://embeds.beehiiv.com/32ceef31-5c45-4b5e-bb4c-817b53183c6a?slim=true"
            title="Subscribe to bhamranked"
            loading="lazy"
            frameborder="0"
            scrolling="no"
            class="newsletter-iframe"
          ></iframe>
        </div>
        <p class="fine">~600 words per email. Unsubscribe in one click. No spam, ever.</p>
      </div>
    </section>
  </main>

  <Footer />

  <SchemaLD blocks={schemaBlocks} />
</BaseLayout>

<style>
  .container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .hero {
    padding: 5rem 0 4rem;
  }

  .kicker {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }
  .kicker::before {
    content: "";
    width: 2.25rem;
    height: 1px;
    background: var(--color-accent);
  }

  .display {
    font-family: var(--font-display);
    font-variation-settings: "SOFT" 30, "WONK" 1, "opsz" 144;
    font-weight: 400;
    font-size: clamp(2.5rem, 6vw, 4.75rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
    max-width: 20ch;
    margin-bottom: 1.5rem;
    color: var(--color-text-primary);
  }

  .lede {
    font-size: 1.3125rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    max-width: 60ch;
    margin-bottom: 2.25rem;
  }

  .cta-row {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 2rem;
  }
  .cta-primary {
    font-family: var(--font-display);
    font-variation-settings: "SOFT" 30, "WONK" 1, "opsz" 144;
    font-weight: 500;
    font-size: 1.25rem;
    color: var(--color-accent);
    border-bottom: 2px solid var(--color-accent);
    padding-bottom: 0.25rem;
  }
  .cta-secondary {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    border: none;
  }
  .cta-secondary:hover { color: var(--color-text-primary); }

  .status {
    padding: 3rem 0 4rem;
  }
  .status-card {
    background: var(--color-bg-elevated);
    padding: 3rem 3rem;
    max-width: 760px;
  }
  .status-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
  }
  .status-headline {
    font-family: var(--font-display);
    font-variation-settings: "SOFT" 30, "WONK" 1, "opsz" 144;
    font-weight: 500;
    font-size: 2rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
    color: var(--color-text-primary);
  }
  .status p {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    max-width: 60ch;
    margin: 0 0 1.5rem;
  }
  .status p.fine {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-text-muted);
    margin-top: 0.75rem;
    letter-spacing: 0.02em;
  }

  .newsletter-iframe-wrap {
    max-width: 480px;
    margin-bottom: 0.75rem;
    background: transparent;
  }
  .newsletter-iframe {
    display: block;
    width: 100%;
    min-height: 80px;
    border: 0;
    background: transparent;
  }

  @media (max-width: 800px) {
    .hero { padding: 3rem 0 2rem; }
    .status-card { padding: 2rem 1.5rem; }
    .newsletter-iframe { min-height: 90px; }
  }
</style>
